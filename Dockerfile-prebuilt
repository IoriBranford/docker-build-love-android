FROM ioribranford/build-love-android:11.5-env

ENV LOVE_VERSION        "6144ef11c93b591e4bb345893e55666ad4e9b982"
ENV LOVE_ANDROID_URL    https://github.com/IoriBranford/love-android.git
ENV LOVE_ANDROID_DIR    /love-android
ENV GRADLE_OPTS         "-Dorg.gradle.jvmargs='-Xmx4G'"

# clone repo
RUN git clone $LOVE_ANDROID_URL ${LOVE_ANDROID_DIR}
WORKDIR ${LOVE_ANDROID_DIR}
RUN git checkout $LOVE_VERSION
RUN git submodule update --init --recursive

# build
RUN ./gradlew assemble bundle
COPY ./build-game.sh .

# to sign packages and zip debug symbols for the Play Store
COPY sign-releases.sh app/build/

CMD ./build-game.sh
